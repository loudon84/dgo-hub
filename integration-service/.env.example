DATABASE_URL=postgres://hub:hub_dev_password@localhost:5432/hub
HASURA_URL=http://localhost:8080
HASURA_ADMIN_SECRET=change-me-admin-secret
HASURA_JWT_SECRET=change-me-hasura-jwt-secret-at-least-32-bytes
INGEST_API_KEY=change-me-ingest-key
ADMIN_API_KEY=change-me-admin-key
AGENT_JWT_SECRET=change-me-at-least-32-bytes-long
AGENT_JWT_ISSUER=data-hub
AGENT_JWT_AUDIENCE=sales-mcp
PORT=3000
MCP_PORT=3001
WORKER_INTERVAL_MS=15000
# Leave unset until the deployment platform enforces raw storage protection.
# Set to deployment_managed only for a deployment-controlled protected volume.
HUB_RAW_STORAGE_POLICY=
# Optional source PostgreSQL URLs for DB ETL
CRM_DB_URL=
ORDER_DB_URL=
# Optional adapters; Helix must remain on a trusted local network.
HELIX_URL=
HELIX_WORKSPACE_ID=
HELIX_READ_TOKEN=
OPENMETADATA_URL=
OPENMETADATA_TOKEN=
OPENMETADATA_CUSTOMER_FQN=
OPENMETADATA_ORDER_FQN=
