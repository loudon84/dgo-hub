{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "alpha1.v1"
    },
    "environment_kind": {
      "type": "string",
      "enum": [
        "local_lab",
        "site"
      ]
    },
    "tenant_key": {
      "type": "string",
      "minLength": 1
    },
    "business_timezone": {
      "type": "string",
      "minLength": 1
    },
    "idp": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "jwks_uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "issuer",
        "audience",
        "jwks_uri"
      ],
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "connection_mode": {
                "type": "string",
                "enum": [
                  "rest",
                  "postgresql",
                  "sqlserver"
                ]
              },
              "endpoint": {
                "type": "string",
                "format": "uri"
              },
              "secret_ref": {
                "type": "string",
                "pattern": "^(env|secret|vault):\\/\\/(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$"
              },
              "mapping_ref": {
                "type": "string",
                "minLength": 1
              },
              "replica_authorization_ref": {
                "type": "string",
                "minLength": 1
              },
              "deletion_contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "read_only": {
                "type": "boolean"
              }
            },
            "required": [
              "source_id",
              "connection_mode",
              "endpoint",
              "secret_ref",
              "mapping_ref",
              "replica_authorization_ref",
              "deletion_contract_ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "connection_mode": {
                "const": "SIMULATED_IMPORT"
              },
              "mode": {
                "const": "INCREMENTAL"
              },
              "version_domain": {
                "const": "SOURCE_VERSION"
              },
              "allowed_entities": {
                "type": "array",
                "items": {
                  "enum": [
                    "customer",
                    "order"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "delete_contract": {
                "const": "tombstone"
              },
              "input_ref": {
                "type": "string",
                "minLength": 1
              },
              "data_contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "mapping_ref": {
                "type": "string",
                "minLength": 1
              },
              "replica_authorization_ref": {
                "type": "string",
                "minLength": 1
              },
              "deletion_contract_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "connection_mode",
              "mode",
              "version_domain",
              "allowed_entities",
              "delete_contract",
              "input_ref",
              "data_contract_ref",
              "version",
              "mapping_ref",
              "replica_authorization_ref",
              "deletion_contract_ref"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "identity_mapping_ref": {
      "type": "string",
      "minLength": 1
    },
    "tls_hostname": {
      "type": "string",
      "minLength": 1
    },
    "internal_services": {
      "type": "object",
      "properties": {
        "hub_api": {
          "type": "string",
          "format": "uri"
        },
        "sales_mcp": {
          "type": "string",
          "format": "uri"
        },
        "hasura": {
          "type": "string",
          "format": "uri"
        },
        "postgres": {
          "type": "string",
          "format": "uri"
        },
        "openmetadata": {
          "type": "string",
          "format": "uri"
        },
        "helix": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "hub_api",
        "sales_mcp",
        "hasura",
        "postgres",
        "openmetadata",
        "helix"
      ],
      "additionalProperties": false
    },
    "backup_ref": {
      "type": "string",
      "minLength": 1
    },
    "hermes": {
      "type": "object",
      "properties": {
        "actual_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actual_version"
      ],
      "additionalProperties": false
    },
    "test_identities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_ref": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "sales",
              "sales_manager"
            ]
          },
          "tenant_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "actor_ref",
          "role",
          "tenant_key"
        ],
        "additionalProperties": false
      }
    },
    "example": {
      "type": "boolean"
    },
    "acceptance_level": {
      "type": "string",
      "enum": [
        "platform",
        "site"
      ]
    }
  },
  "required": [
    "schema_version",
    "environment_kind",
    "tenant_key",
    "business_timezone",
    "idp",
    "sources",
    "identity_mapping_ref",
    "tls_hostname",
    "internal_services",
    "backup_ref",
    "test_identities",
    "example"
  ],
  "additionalProperties": false,
  "title": "Alpha1 EnvironmentInput",
  "description": "Alpha1 environment structure. Runtime validation additionally enforces security, protocol, identity, timezone and reference rules; this schema does not establish readiness.",
  "$comment": "Tracks integration-service/contracts/environment.ts. Runtime refinements remain authoritative; schema validity does not prove a live environment.",
  "x-runtime-validation": [
    "environment-kind-specific HTTPS and loopback rules",
    "endpoint protocols and credential or secret query rejection",
    "unique source_id and actor_ref values",
    "IANA timezone validation",
    "tenant-bound identities and site sales and sales_manager minimums",
    "synthetic identity references cannot satisfy site or platform readiness",
    "database source read_only requirement",
    "non-whitespace references and hostname validation"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "acceptance_level"
        ],
        "properties": {
          "acceptance_level": {
            "const": "platform"
          }
        }
      },
      "then": {
        "properties": {
          "environment_kind": {
            "const": "site"
          },
          "sources": {
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "connection_mode": {
                  "const": "SIMULATED_IMPORT"
                },
                "mode": {
                  "const": "INCREMENTAL"
                },
                "version_domain": {
                  "const": "SOURCE_VERSION"
                },
                "allowed_entities": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "customer",
                      "order"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "delete_contract": {
                  "const": "tombstone"
                },
                "input_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "data_contract_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "mapping_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "replica_authorization_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "deletion_contract_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "connection_mode",
                "mode",
                "version_domain",
                "allowed_entities",
                "delete_contract",
                "input_ref",
                "data_contract_ref",
                "version",
                "mapping_ref",
                "replica_authorization_ref",
                "deletion_contract_ref"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "else": {
        "required": [
          "hermes"
        ],
        "properties": {
          "sources": {
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "connection_mode": {
                  "type": "string",
                  "enum": [
                    "rest",
                    "postgresql",
                    "sqlserver"
                  ]
                },
                "endpoint": {
                  "type": "string",
                  "format": "uri"
                },
                "secret_ref": {
                  "type": "string",
                  "pattern": "^(env|secret|vault):\\/\\/(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$"
                },
                "mapping_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "replica_authorization_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "deletion_contract_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "read_only": {
                  "type": "boolean"
                }
              },
              "required": [
                "source_id",
                "connection_mode",
                "endpoint",
                "secret_ref",
                "mapping_ref",
                "replica_authorization_ref",
                "deletion_contract_ref"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment_kind": {
            "const": "local_lab"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "acceptance_level"
          ]
        }
      }
    }
  ]
}
